#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
timezone: ${timezone}
users:
  - name: ${automation_user}
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    lock_passwd: true
    ssh_authorized_keys:
%{ for key in ssh_authorized_keys ~}
      - ${jsonencode(key)}
%{ endfor ~}
package_update: true
packages:
%{ for package in essential_packages ~}
  - ${jsonencode(package)}
%{ endfor ~}
runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
final_message: "Cloud-init completed; the VM is ready for Ansible."
